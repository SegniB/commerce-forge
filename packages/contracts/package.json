{
  "name": "@commerce-forge/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared runtime-validated API contracts for CommerceForge.",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint --fix src tests",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "oxlint": "^1.74.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}